<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="x-ua-compatible" content="ie=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ page_title }}{% if current_page != 1 %} — {{ 'general.pagination.page' | t: number: current_page }}{% endif %}</title>
    <meta name="description" content="{{ page_description | escape }}">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600;700&family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
      :root {
        --color-primary: {{ settings.accent_color }};
        --color-gold: {{ settings.gold_color }};
        --color-background: {{ settings.background_color }};
      }
      body {
        font-family: {{ settings.body_font.family }}, {{ settings.body_font.fallback_families }};
      }
      h1, h2, h3, h4, h5, h6 {
        font-family: {{ settings.heading_font.family }}, {{ settings.heading_font.fallback_families }};
      }
    </style>
    {{ 'theme.css' | asset_url | stylesheet_tag }}
    <script src="{{ 'theme.js' | asset_url }}" defer></script>
    {{ content_for_header }}
  </head>
  <body class="gradient">
    <a class="skip-link" href="#MainContent">{{ 'general.accessibility.skip_to_content' | t }}</a>
    {% section 'header' %}
    <main id="MainContent" class="page-width">
      {{ content_for_layout }}
    </main>
    {% section 'footer' %}
    {{ content_for_footer }}
  </body>
</html>
