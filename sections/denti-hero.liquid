{% schema %}
{
  "name": "Denti – Hero",
  "settings": [
    {"type":"text","id":"heading","label":"Titre","default":"Un sourire éclatant en 7 jours"},
    {"type":"textarea","id":"subheading","label":"Sous-titre","default":"Découvrez le Kit LED Denti Luxe, la solution premium pour un blanchiment efficace sans douleur."},
    {"type":"text","id":"cta_label","label":"Texte du bouton","default":"Commander maintenant"},
    {"type":"url","id":"cta_link","label":"Lien du bouton","default":"/products/kit-led-denti-luxe"},
    {"type":"text","id":"badge","label":"Badge","default":"-30 % aujourd'hui"},
    {"type":"image_picker","id":"image","label":"Image","default":"https://cdn.shopify.com/s/files/1/0772/0953/4709/files/hero_led_kit.png?v=1761221036"}
  ],
  "presets": [{"name":"Denti – Hero"}]
}
{% endschema %}
<section class="hero reveal" data-section-id="{{ section.id }}">
  <div class="hero__media" aria-hidden="true">
    <img src="{{ section.settings.image | default: 'https://cdn.shopify.com/s/files/1/0772/0953/4709/files/hero_led_kit.png?v=1761221036' }}" alt="" loading="lazy" data-hero-parallax>
    <span class="hero__overlay"></span>
  </div>
  <div class="container">
    <div class="hero__content">
      <span class="badge">{{ section.settings.badge }}</span>
      <h1>{{ section.settings.heading }}</h1>
      <p>{{ section.settings.subheading }}</p>
      <div class="hero__actions">
        <a class="btn-primary" href="{{ section.settings.cta_link }}">{{ section.settings.cta_label }}</a>
      </div>
      <div class="mini-badge">✅ Livraison 24-72h • 🇲🇦 Paiement à la livraison</div>
    </div>
  </div>
</section>
