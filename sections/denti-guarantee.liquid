{% schema %}
{
  "name": "Denti – Garantie",
  "settings": [
    {"type":"text","id":"title","label":"Titre","default":"Livraison 24–72h • Paiement à la livraison • Garantie 30 jours"},
    {"type":"textarea","id":"text","label":"Texte","default":"Chaque commande est suivie par notre équipe support basée au Maroc. Essayez le kit Denti Luxe sans risque !"}
  ],
  "presets": [{"name":"Denti – Garantie"}]
}
{% endschema %}
<section class="reveal" data-section-id="{{ section.id }}">
  <div class="container">
    <div class="guarantee">
      <h2>{{ section.settings.title }}</h2>
      <p>{{ section.settings.text }}</p>
    </div>
  </div>
</section>
