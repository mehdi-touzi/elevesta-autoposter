<header class="site-header">
  <div class="announcement" data-scroll="fade">
    <span>{{ section.settings.announcement_text }}</span>
  </div>
  <div class="header-inner">
    <a class="logo" href="/">
      {% if section.settings.logo != blank %}
        <img src="{{ section.settings.logo | image_url: width: 200 }}" alt="{{ shop.name }}" loading="lazy">
      {% else %}
        <span class="logo-text">{{ shop.name }}</span>
      {% endif %}
    </a>
    <nav class="main-nav" aria-label="Navigation principale">
      <ul>
        {% assign menu = linklists[section.settings.menu] %}
        {% if menu != blank %}
          {% for link in menu.links %}
            <li>
              <a href="{{ link.url }}" class="nav-link">{{ link.title }}</a>
            </li>
          {% endfor %}
        {% endif %}
      </ul>
    </nav>
    <div class="header-actions">
      <a href="/cart" class="button button--outline">{{ 'layout.cart.title' | t }}</a>
    </div>
  </div>
</header>

{% schema %}
{
  "name": "En-tête Denti Luxe",
  "settings": [
    {
      "type": "text",
      "id": "announcement_text",
      "label": "Texte d'annonce",
      "default": "Livraison Cash à la livraison dans tout le Maroc"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu principal",
      "default": "main-menu"
    }
  ]
}
{% endschema %}
