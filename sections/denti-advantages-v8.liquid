<section class="section" data-reveal>
  <div class="section__inner">
    <h2>{{ section.settings.heading | escape }}</h2>
    <div class="scroll-snap">
      {% for block in section.blocks %}
        <article class="advantages-card" {{ block.shopify_attributes }}>
          <img src="{{ block.settings.icon | default: block.settings.default_icon }}" alt="">
          <h3>{{ block.settings.title | escape }}</h3>
          <p>{{ block.settings.description }}</p>
        </article>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Denti Avantages V8",
  "max_blocks": 5,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Titre",
      "default": "Pourquoi Denti Luxe est différent"
    }
  ],
  "blocks": [
    {
      "type": "advantage",
      "name": "Avantage",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Titre",
          "default": "Livraison partout au Maroc"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Recevez votre kit en 24-48h avec suivi et confirmation téléphonique."
        },
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icône"
        },
        {
          "type": "text",
          "id": "default_icon",
          "label": "Icône par défaut",
          "default": "https://cdn.shopify.com/s/files/1/0772/0953/4709/files/livraison.png?v=1761221036"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Denti Avantages V8",
      "blocks": [
        {
          "type": "advantage",
          "settings": {
            "title": "Livraison rapide Maroc",
            "description": "Expédition depuis le Maroc avec suivi SMS.",
            "default_icon": "https://cdn.shopify.com/s/files/1/0772/0953/4709/files/livraison.png?v=1761221036"
          }
        },
        {
          "type": "advantage",
          "settings": {
            "title": "Garantie satisfaction",
            "description": "Résultats visibles ou remboursement sous 30 jours.",
            "default_icon": "https://cdn.shopify.com/s/files/1/0772/0953/4709/files/garantie.png?v=1761221036"
          }
        },
        {
          "type": "advantage",
          "settings": {
            "title": "Paiement à la livraison",
            "description": "Réglez en espèces à la réception de votre commande.",
            "default_icon": "https://cdn.shopify.com/s/files/1/0772/0953/4709/files/satisfaction.png?v=1761221035"
          }
        }
      ]
    }
  ]
}
{% endschema %}
