{% schema %}
{
  "name": "Denti – Avant/Après",
  "settings": [
    {"type":"text","id":"title","label":"Titre","default":"Des sourires transformés"},
    {"type":"textarea","id":"description","label":"Description","default":"Découvrez les résultats obtenus par nos clientes Denti Luxe."},
    {"type":"textarea","id":"images","label":"Images (URLs séparées par virgules)","default":"https://cdn.shopify.com/s/files/1/0772/0953/4709/files/before_after_1.webp?v=1761221034, https://cdn.shopify.com/s/files/1/0772/0953/4709/files/before_after_2.webp?v=1761221034, https://cdn.shopify.com/s/files/1/0772/0953/4709/files/before_after_3.webp?v=1761221035, https://cdn.shopify.com/s/files/1/0772/0953/4709/files/before_after_4.webp?v=1761221035, https://cdn.shopify.com/s/files/1/0772/0953/4709/files/before_after_5.webp?v=1761221036"}
  ],
  "presets": [{"name":"Denti – Avant/Après"}]
}
{% endschema %}
<section class="before-after reveal" data-section-id="{{ section.id }}">
  <div class="container">
    <div class="text-center" style="margin-bottom:36px;">
      <span class="label">Preuves sociales</span>
      <h2>{{ section.settings.title }}</h2>
      <p>{{ section.settings.description }}</p>
    </div>
    {% assign images = section.settings.images | split: ',' %}
    <div class="before-after__wrapper" data-beforeafter-slider>
      <div class="before-after__viewport">
        {% for image in images %}
          {% assign clean = image | strip %}
          {% if clean != '' %}
            <div class="before-after__item">
              <img src="{{ clean }}" alt="Résultat avant après {{ forloop.index }}" width="420" height="560" loading="lazy">
            </div>
          {% endif %}
        {% endfor %}
      </div>
      <div class="slider-nav">
        <button type="button" aria-label="Précédent" data-slider-prev>&larr;</button>
        <button type="button" aria-label="Suivant" data-slider-next>&rarr;</button>
      </div>
    </div>
  </div>
</section>
