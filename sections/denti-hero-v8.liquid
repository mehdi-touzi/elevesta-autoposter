<section class="hero section" data-reveal>
  <div class="section__inner hero__grid">
    <div class="hero__content">
      <div class="hero__brand">
        <img src="{{ section.settings.logo | default: 'https://cdn.shopify.com/s/files/1/0772/0953/4709/files/logo_denti_luxe.png?v=1761220999' }}" alt="{{ shop.name }} logo">
      </div>
      <div class="trust-bar">
        <span>Paiement à la réception</span>
        <span class="trust-bar__dot"></span>
        <span>Livraison partout au Maroc</span>
        <span class="trust-bar__dot"></span>
        <span>Sourire lumineux</span>
      </div>
      <div class="hero__halo">
        <h1>{{ section.settings.heading | escape }}</h1>
        <p>{{ section.settings.subheading }}</p>
        <div class="hero__actions">
          <a href="#product" class="btn btn--gold" data-scroll-to>{{ section.settings.primary_label }}</a>
          <a href="#faq" class="btn btn--outline" data-scroll-to>{{ section.settings.secondary_label }}</a>
        </div>
      </div>
    </div>
    <div class="hero__visual">
      <div class="hero__image glass-card">
        <img src="{{ section.settings.hero_image | default: 'https://cdn.shopify.com/s/files/1/0772/0953/4709/files/hero_led_kit.png?v=1761221036' }}" alt="Kit LED Denti Luxe">
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Denti Hero V8",
  "tag": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titre",
      "default": "Sourire Blanc en 10 Minutes"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Sous-titre",
      "default": "Le Kit LED Denti Luxe élimine les taches tenaces grâce à une technologie lumière froide, sans sensibilités."
    },
    {
      "type": "text",
      "id": "primary_label",
      "label": "Texte du bouton principal",
      "default": "Commander maintenant"
    },
    {
      "type": "text",
      "id": "secondary_label",
      "label": "Texte du bouton secondaire",
      "default": "Découvrir la FAQ"
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Image principale"
    }
  ],
  "presets": [
    {
      "name": "Denti Hero V8"
    }
  ]
}
{% endschema %}
