{% schema %}
{
  "name": "Denti – FAQ",
  "settings": [
    {"type":"text","id":"title","label":"Titre","default":"Questions fréquentes"}
  ],
  "blocks": [
    {
      "type":"faq",
      "name":"Question",
      "settings": [
        {"type":"text","id":"question","label":"Question","default":"Combien de temps pour voir les résultats ?"},
        {"type":"textarea","id":"answer","label":"Réponse","default":"La majorité de nos clientes constatent un sourire plus blanc en 7 jours seulement."}
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [{"name":"Denti – FAQ","blocks":[{"type":"faq"},{"type":"faq"},{"type":"faq"},{"type":"faq"},{"type":"faq"},{"type":"faq"}]}]
}
{% endschema %}
<section class="reveal" data-section-id="{{ section.id }}">
  <div class="container">
    <div class="text-center" style="margin-bottom:36px;">
      <span class="label">Besoin d'aide ?</span>
      <h2>{{ section.settings.title }}</h2>
    </div>
    <div class="faq" role="list">
      {% for block in section.blocks %}
        <div class="faq-item" {{ block.shopify_attributes }} role="listitem">
          <button class="faq-question" aria-expanded="false">
            <span>{{ block.settings.question }}</span>
            <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true"><path fill="currentColor" d="M12 5v14m-7-7h14"/></svg>
          </button>
          <div class="faq-answer">
            <p>{{ block.settings.answer }}</p>
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</section>
