<section class="product-page" data-scroll="fade">
  <div class="product-page__gallery">
    {% for image in product.images %}
      <img src="{{ image | image_url: width: 900 }}" alt="{{ image.alt | escape }}" loading="lazy">
    {% else %}
      <div class="product-placeholder"></div>
    {% endfor %}
  </div>
  <div class="product-page__details">
    <h1 class="product-title">{{ product.title }}</h1>
    <div class="product-price">{{ product.price | money }}</div>
    <div class="product-description rte">{{ product.description }}</div>
    {% form 'product', product %}
      {% if product.has_only_default_variant == false %}
        {% for option in product.options_with_values %}
          <label for="Option{{ forloop.index }}">{{ option.name }}</label>
          <select id="Option{{ forloop.index }}" name="options[{{ option.name }}]">
            {% for value in option.values %}
              <option value="{{ value }}" {% if option.selected_value == value %}selected{% endif %}>{{ value }}</option>
            {% endfor %}
          </select>
        {% endfor %}
      {% endif %}
      <div class="product-form__buttons">
        <input type="number" name="quantity" min="1" value="1" class="quantity">
        <button type="submit" class="button button--halo">{{ 'products.product.add_to_cart' | t }}</button>
      </div>
      <p class="cod-info">{{ section.settings.cod_info }}</p>
    {% endform %}
  </div>
</section>

{% schema %}
{
  "name": "Produit Denti Luxe",
  "settings": [
    {
      "type": "text",
      "id": "cod_info",
      "label": "Texte paiement à la livraison",
      "default": "Paiement à la livraison disponible partout au Maroc."
    }
  ]
}
{% endschema %}
