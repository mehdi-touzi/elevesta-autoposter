<section class="trust-bar" data-scroll="fade">
  <div class="trust-items">
    {% for block in section.blocks %}
      <div class="trust-item" data-scroll="fade">
        {% if block.settings.icon != blank %}
          <img src="{{ block.settings.icon | image_url: width: 80 }}" alt="" loading="lazy">
        {% else %}
          <span class="trust-placeholder"></span>
        {% endif %}
        <div>
          <h3>{{ block.settings.title }}</h3>
          <p>{{ block.settings.text }}</p>
        </div>
      </div>
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "Barre de confiance",
  "max_blocks": 4,
  "blocks": [
    {
      "type": "item",
      "name": "Élément",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icône"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Titre",
          "default": "Livraison express 24/48h"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Texte",
          "default": "Disponible dans tout le Maroc"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Barre de confiance",
      "category": "Confiance",
      "blocks": [
        {"type": "item"},
        {"type": "item"},
        {"type": "item"}
      ]
    }
  ]
}
{% endschema %}
