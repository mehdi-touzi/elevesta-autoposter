<section class="section testimonials" data-reveal>
  <div class="section__inner">
    <h2>{{ section.settings.heading | escape }}</h2>
    <p>{{ section.settings.subheading }}</p>
    <div class="testimonials__viewport">
      <div class="testimonials__track" data-testimonials-track>
        {% for block in section.blocks %}
          <article class="testimonial-card" {{ block.shopify_attributes }}>
            <div class="testimonial-card__stars">★★★★★</div>
            <h3>{{ block.settings.name | escape }}</h3>
            <p>{{ block.settings.review }}</p>
            <p><strong>{{ block.settings.location | escape }}</strong></p>
          </article>
        {% endfor %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Denti Témoignages V8",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Titre",
      "default": "Ils ont adopté Denti Luxe"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Sous-titre",
      "default": "3 000+ clients satisfaits partout au Maroc."
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Avis",
      "settings": [
        {
          "type": "text",
          "id": "name",
          "label": "Nom",
          "default": "Salma"
        },
        {
          "type": "textarea",
          "id": "review",
          "label": "Avis",
          "default": "Résultat bluffant en 7 jours seulement, sans aucune sensibilité."
        },
        {
          "type": "text",
          "id": "location",
          "label": "Ville",
          "default": "Casablanca"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Denti Témoignages V8",
      "blocks": [
        {
          "type": "review",
          "settings": {
            "name": "Salma",
            "review": "Le kit est super simple à utiliser, mes dents sont plus blanches dès la première semaine.",
            "location": "Casablanca"
          }
        },
        {
          "type": "review",
          "settings": {
            "name": "Yassine",
            "review": "Service client très réactif et livraison rapide à Rabat, je recommande !",
            "location": "Rabat"
          }
        },
        {
          "type": "review",
          "settings": {
            "name": "Amal",
            "review": "Enfin un kit qui fonctionne vraiment, je garde mon sourire lumineux avant les soirées.",
            "location": "Marrakech"
          }
        }
      ]
    }
  ]
}
{% endschema %}
