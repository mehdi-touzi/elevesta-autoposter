<section class="testimonials" data-scroll="fade">
  <header class="section-heading">
    <h2>{{ section.settings.heading }}</h2>
    <p>{{ section.settings.subheading }}</p>
  </header>
  <div class="testimonials__grid">
    {% for block in section.blocks %}
      <article class="testimonial" data-scroll="fade">
        <p class="testimonial__quote">“{{ block.settings.quote }}”</p>
        <div class="testimonial__author">
          <span class="author-name">{{ block.settings.author }}</span>
          <span class="author-role">{{ block.settings.role }}</span>
        </div>
      </article>
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "Témoignages Denti Luxe",
  "max_blocks": 3,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Titre",
      "default": "Ils ont adopté le sourire Denti Luxe"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Sous-titre",
      "default": "Des avis clients vérifiés et des dentistes partenaires convaincus."
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Témoignage",
      "settings": [
        {
          "type": "textarea",
          "id": "quote",
          "label": "Citation",
          "default": "Un kit premium livré en 24h, des résultats visibles dès la première semaine."
        },
        {
          "type": "text",
          "id": "author",
          "label": "Auteur",
          "default": "Imane, Casablanca"
        },
        {
          "type": "text",
          "id": "role",
          "label": "Rôle",
          "default": "Cliente vérifiée"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Témoignages",
      "category": "Texte",
      "blocks": [
        {"type": "testimonial"},
        {"type": "testimonial"},
        {"type": "testimonial"}
      ]
    }
  ]
}
{% endschema %}
