<section class="section" data-reveal>
  <div class="section__inner before-after">
    <h2>{{ section.settings.heading | escape }}</h2>
    <p>{{ section.settings.subtitle }}</p>
    <div class="before-after__track">
      {% for block in section.blocks %}
        <figure class="glass-card" {{ block.shopify_attributes }}>
          <img src="{{ block.settings.image | default: block.settings.default_image }}" alt="Résultat Denti Luxe">
        </figure>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Denti Avant/Après V8",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Titre",
      "default": "Résultats prouvés par nos clients"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Sous-titre",
      "default": "Des sourires plus blancs en quelques séances seulement."
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Avant/Après",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "default_image",
          "label": "Image par défaut",
          "default": "https://cdn.shopify.com/s/files/1/0772/0953/4709/files/before_after_1.webp?v=1761221034"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Denti Avant/Après V8",
      "blocks": [
        {
          "type": "slide",
          "settings": {
            "default_image": "https://cdn.shopify.com/s/files/1/0772/0953/4709/files/before_after_1.webp?v=1761221034"
          }
        },
        {
          "type": "slide",
          "settings": {
            "default_image": "https://cdn.shopify.com/s/files/1/0772/0953/4709/files/before_after_2.webp?v=1761221034"
          }
        },
        {
          "type": "slide",
          "settings": {
            "default_image": "https://cdn.shopify.com/s/files/1/0772/0953/4709/files/before_after_3.webp?v=1761221035"
          }
        },
        {
          "type": "slide",
          "settings": {
            "default_image": "https://cdn.shopify.com/s/files/1/0772/0953/4709/files/before_after_4.webp?v=1761221035"
          }
        },
        {
          "type": "slide",
          "settings": {
            "default_image": "https://cdn.shopify.com/s/files/1/0772/0953/4709/files/before_after_5.webp?v=1761221036"
          }
        }
      ]
    }
  ]
}
{% endschema %}
